#!/usr/bin/env bash
# Pre-commit гейт (Фаза 5 рефакторинга). Не пускает красный билд в main: перед
# КАЖДЫМ коммитом гоняет проверки той части, которую правят (по staged-файлам).
#   frontend/* → tsc -b + eslint + vitest
#   backend/*  → ruff + mypy + pytest
#   скрипты поставки и разработки (deploy/*.sh|*.py, scripts/*.sh, хук, dev.sh, stop.sh)
#              → bash -n + ruff (аудит P-33: раньше их не видел никто)
#   CLAUDE.md, QWEN.md, scripts/agent-docs.py → QWEN.md собран из CLAUDE.md (аудит P-7)
#   docs-site/* → типы + тесты генератора + сборка (битые ссылки и якоря — блок)
# NB: именно `tsc -b`, не `tsc --noEmit`. Корневой tsconfig.json — solution-config
# (files:[], только references) → `tsc --noEmit` НИЧЕГО не проверяет (тихо exit 0).
# `tsc -b` идёт по ссылкам на tsconfig.app/node.json и реально типизирует src.
# Обойти в крайнем случае: git commit --no-verify (осознанно, под ответственность).
#
# Подключается через core.hooksPath=scripts/git-hooks (ставит dev.sh или
# scripts/setup-hooks.sh). Сам hooksPath — локальный git-конфиг, не трекается,
# поэтому после клона его выставляет dev.sh идемпотентно.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

ok()   { printf '\033[1;32m[hook]\033[0m %s\n' "$*"; }
say()  { printf '\033[1;36m[hook]\033[0m %s\n' "$*"; }
err()  { printf '\033[1;31m[hook] БЛОК:\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m[hook]\033[0m %s\n' "$*" >&2; }

# Staged-файлы (добавленные/изменённые/переименованные; удаления не проверяем)
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if [ -z "$staged" ]; then
  exit 0
fi

touch_front=false
touch_back=false
touch_mcp=false
touch_docs=false
if grep -q '^frontend/'  <<<"$staged"; then touch_front=true; fi
if grep -q '^backend/'   <<<"$staged"; then touch_back=true;  fi
if grep -q '^mcp/'       <<<"$staged"; then touch_mcp=true;   fi
if grep -q '^docs-site/' <<<"$staged"; then touch_docs=true;  fi
# Сентинелы MCP читают исходники фронта (панель алертов, фасад типов, тексты якоря):
# их правка гоняет и MCP-гейт, иначе CI падал молча (фаза 7 аудита, ALERT_SECTIONS).
# Список берётся из самих тестов — новый сентинел подхватится без правки хука.
mcp_watch="$(grep -rhoE 'frontend/src/[A-Za-z0-9_./-]+' mcp/tests 2>/dev/null | sort -u || true)"
if [ -n "$mcp_watch" ] && grep -qxFf <(printf '%s\n' "$mcp_watch") <<<"$staged"; then touch_mcp=true; fi
# Скрипты: shell — bash -n, python поставки — ruff бэкенда
scripts_sh="$(grep -E '^(deploy/.*\.sh|scripts/.*\.sh|scripts/git-hooks/[^/]+|dev\.sh|stop\.sh)$' <<<"$staged" || true)"
scripts_py="$(grep -E '^deploy/.*\.py$' <<<"$staged" || true)"

# --- Скрипты: синтаксис shell и ruff по python поставки ---
if [ -n "$scripts_sh" ]; then
  say "Скрипты: bash -n…"
  while IFS= read -r f; do
    bash -n "$f" || { err "синтаксическая ошибка в $f"; exit 1; }
  done <<<"$scripts_sh"
fi
if [ -n "$scripts_py" ] && [ -x backend/venv/bin/ruff ]; then
  say "Скрипты поставки: ruff…"
  # shellcheck disable=SC2086 # список файлов намеренно разбивается по словам
  backend/venv/bin/ruff check --config backend/pyproject.toml $scripts_py
fi

# --- Правила агентов: QWEN.md собирается из CLAUDE.md ---
if grep -qE '^(CLAUDE\.md|QWEN\.md|scripts/agent-docs\.py)$' <<<"$staged"; then
  say "Правила агентов: QWEN.md против CLAUDE.md…"
  python3 scripts/agent-docs.py --check || { err "QWEN.md отстал: python3 scripts/agent-docs.py"; exit 1; }
fi

# --- Фронтенд: типы + тесты ---
if $touch_front; then
  if [ ! -d frontend/node_modules ]; then
    warn "frontend/node_modules нет — пропускаю фронт-гейт (запусти ./dev.sh)."
  else
    say "Фронт: tsc -b…"
    ( cd frontend && npx tsc -b )
    say "Фронт: eslint…"
    ( cd frontend && npx eslint . )
    say "Фронт: vitest run…"
    ( cd frontend && npx vitest run )
    ok "Фронт-гейт зелёный."
  fi
fi

# --- Бэкенд: pytest ---
if $touch_back; then
  if [ ! -x backend/venv/bin/python ]; then
    warn "backend/venv нет — пропускаю бэк-гейт (создай venv, см. dev.sh)."
  else
    # venv есть, но ruff/mypy в нём нет — это рассинхрон зависимостей, а не повод пропустить.
    if [ ! -x backend/venv/bin/ruff ] || [ ! -x backend/venv/bin/mypy ]; then
      err "backend/venv есть, но ruff/mypy в нём нет — выполни: ( cd backend && ./venv/bin/pip install -r requirements.txt )"
      exit 1
    fi
    say "Бэк: ruff check…"
    ( cd backend && ./venv/bin/ruff check . )
    say "Бэк: mypy…"
    ( cd backend && ./venv/bin/mypy app/ )
    say "Бэк: pytest…"
    ( cd backend && ./venv/bin/python -m pytest -q )
    ok "Бэк-гейт зелёный."
  fi
fi

# --- MCP-сервер: та же строгость, что у бэкенда ---
if $touch_mcp; then
  if [ ! -x mcp/venv/bin/python ]; then
    warn "mcp/venv нет — пропускаю MCP-гейт (см. mcp/README.md)."
  else
    say "MCP: ruff check…"
    ( cd mcp && ./venv/bin/ruff check . )
    say "MCP: mypy…"
    ( cd mcp && ./venv/bin/mypy )
    say "MCP: pytest…"
    ( cd mcp && ./venv/bin/python -m pytest -q )
    ok "MCP-гейт зелёный."
  fi
fi

# --- Документация: типы и тесты генератора, сборка с проверкой ссылок ---
if $touch_docs; then
  if [ ! -d docs-site/node_modules ]; then
    warn "docs-site/node_modules нет — пропускаю гейт документации (cd docs-site && npm ci)."
  else
    say "Документация: типы и тесты генератора…"
    ( cd docs-site && npm run --silent check )
    say "Документация: сборка с проверкой ссылок…"
    ( cd docs-site && npm run --silent build )
    ok "Гейт документации зелёный."
  fi
fi

exit 0
