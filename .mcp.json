{
  "mcpServers": {
    "python-lsp": {
      "command": ".claude/mcp-servers/python-lsp/venv/bin/python",
      "args": [
        ".claude/mcp-servers/python-lsp/server.py"
      ],
      "env": {
        "PROJECT_ROOT": "backend"
      }
    },
    "typescript-lsp": {
      "command": "node",
      "args": [
        ".claude/mcp-servers/typescript-lsp/server.js"
      ],
      "env": {
        "PROJECT_ROOT": "frontend"
      }
    },
    "archmap": {
      "command": "mcp/venv/bin/python",
      "args": [
        "-m",
        "archmap_mcp.server"
      ],
      "env": {
        "PYTHONPATH": "mcp"
      }
    }
  }
}
