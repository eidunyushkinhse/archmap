# Скопируйте в mcp/.env и заполните. Файл в .gitignore — токен и пароль в репозиторий не уедут.
ARCHMAP_URL=http://localhost:8000
# Личный токен доступа (меню профиля → «Токены для MCP») — рекомендуемый способ:
# пароль в файле не нужен, токен отзывается. Задан токен — логин и пароль не нужны.
ARCHMAP_TOKEN=
# Или логин и пароль учётки ArchMap.
ARCHMAP_USERNAME=
ARCHMAP_PASSWORD=
# Необязательно: архивы проекта пишутся только внутри этого каталога.
# ARCHMAP_EXPORT_DIR=~/archmap-exports
# Необязательно: кэш файла сборщика фактов (archmap_scan) и предел его запуска в секундах.
# ARCHMAP_SCAN_DIR=~/.cache/archmap-mcp
# ARCHMAP_SCAN_TIMEOUT=600
