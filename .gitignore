# ===== Python / backend =====
backend/venv/
**/venv/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== Node / frontend =====
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# ===== Секреты и окружение =====
# .env коммитить нельзя, шаблон .env.example — можно
.env
.env.*
!.env.example

# ===== Локальные настройки Claude =====
# Личный allow-list разрешений и дев-токены — у каждого свои (в любом каталоге)
**/settings.local.json

# ===== Локальные настройки Qwen =====
# Память/настройки/ворктри агента — локальное состояние, в репозиторий не тащим
.qwen/

# Тяжёлые рантаймы MCP-LSP серверов (исходники server.py/server.js коммитим)
.claude/mcp-servers/python-lsp/venv/
.claude/mcp-servers/typescript-lsp/node_modules/

# ===== Логи =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== БД-дампы (на всякий случай) =====
*.sqlite
*.sqlite3
*.db

# ===== ТЗ от Claude Design (локально, в репозиторий не тащим) =====
design_briefs/
*:Zone.Identifier

# ===== ОС и редакторы =====
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
scripts/.polygon/

# MCP-сервер: venv и секреты подключения (пароль не должен уехать в репозиторий —
# .mcp.json трекается, поэтому учётка живёт здесь)
mcp/venv/
mcp/.env

# Сохранённые сценарии Workflow (.claude/workflows/*.js) — рабочие артефакты
# экспериментов пользователя (например, byoa-etalons.js: сборка пяти эталонных
# C4-схем Zabbix/Sentry/Zulip/Grafana/мультирепо для отладки BYOA, 2026-08-19,
# с путями во временный scratchpad). Решение 2026-09-04: такие артефакты НЕ
# версионируются наравне с продуктовым кодом. Файлы лежат локально, в репозиторий
# не попадают.
.claude/workflows/
