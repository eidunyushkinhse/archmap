# Служба ArchMap (бэкенд FastAPI). Устанавливает deploy/install.sh, метки __…__ он же
# подставляет. Файл перезаписывается при каждом обновлении — свои параметры задавайте
# через `systemctl edit archmap`.
[Unit]
Description=ArchMap
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
# Значения по умолчанию; archmap.env их переопределяет
Environment=ARCHMAP_PORT=8000 ARCHMAP_WORKERS=2
EnvironmentFile=__ETC__/archmap.env
WorkingDirectory=__PREFIX__/current/backend
ExecStart=__PREFIX__/current/python/bin/python3 -m uvicorn app.main:app \
  --host 127.0.0.1 --port ${ARCHMAP_PORT} --workers ${ARCHMAP_WORKERS} \
  --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3
TimeoutStopSec=20
# Приложение ничего не пишет на диск: система только для чтения, свой /tmp
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Ядро, устройства, пространства имён и привилегии службе не нужны (аудит P-14). Оценка —
# `systemd-analyze security archmap`. Незнакомые старому systemd строки он пропускает с
# предупреждением в журнале.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
PrivateDevices=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
# Сеть — TCP к клиентам и к базе и сокет PostgreSQL на той же машине
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
# Набор вызовов обычной службы; лишний вызов получает отказ EPERM, а не убивает процесс
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
