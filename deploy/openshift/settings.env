# Несекретные настройки ArchMap: KEY=значение, комментарии отдельной строкой.
# Адрес базы и ключ подписи — в секрете archmap-secrets (DEPLOY.md, «OpenShift»).

# Учётки заводит администратор на экране «Пользователи»; самостоятельной регистрации нет
ALLOW_SIGNUP=false

# Рабочих процессов в поде; каждый держит до 15 соединений с PostgreSQL
WEB_CONCURRENCY=2

# Неудачных попыток входа в минуту с одного адреса, дальше отказ; 0 — без ограничения
LOGIN_ATTEMPTS_PER_MINUTE=10

# Предел размера запроса (ввоз архива проекта), МБ
MAX_REQUEST_MB=64
