# Настройки ArchMap на сервере. Файл читают служба (EnvironmentFile в systemd) и
# команды archmap-admin. Формат: KEY=значение, без пробелов вокруг «=».

# PostgreSQL 15 или новее, отдельная база в UTF-8, пользователь — её владелец.
# Спецсимволы пароля %-кодируются: «@» → %40, «:» → %3A, «/» → %2F, «%» → %25,
# «#» → %23, «?» → %3F (или подберите пароль из букв и цифр).
DATABASE_URL=postgresql://archmap:ПАРОЛЬ@хост-БД:5432/archmap

# Секрет подписи токенов входа, не короче 32 символов. Установщик кладёт сюда
# случайный ключ; если его сменить, всем пользователям придётся войти заново.
SECRET_KEY=__SECRET__

# Учётки заводит администратор на экране «Пользователи»; самостоятельной регистрации нет.
ALLOW_SIGNUP=false

# Адрес, по которому пользователи открывают ArchMap (несколько — через запятую).
CORS_ORIGINS=__ORIGIN__

# Порт бэкенда на 127.0.0.1 (к нему обращается nginx) и число рабочих процессов.
ARCHMAP_PORT=8000
ARCHMAP_WORKERS=2
