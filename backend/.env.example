# Шаблон локального окружения. Скопируйте в .env:  cp .env.example .env
# .env в .gitignore — реальные секреты в репозиторий не попадают.

# Адрес PostgreSQL (используют uvicorn и alembic).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/archmap

# Секрет подписи JWT. ОБЯЗАТЕЛЬНО замените заглушку случайным значением от 32 символов:
#   openssl rand -hex 32
# С заглушкой (или пустой) приложение не стартует — fail-fast.
SECRET_KEY=change-me-in-production-needs-32-bytes

# Разрешённые CORS-источники через запятую. Для прода укажите реальный домен фронта.
CORS_ORIGINS=http://localhost:5173

# Открытая регистрация (POST /api/v1/auth/register). По умолчанию true — как раньше.
# В закрытом контуре ставьте false: учётки заводит администратор на экране
# «Пользователи», первого администратора — командой python -m app.admin create-admin.
# ALLOW_SIGNUP=true

# Токен входа: алгоритм подписи и срок жизни в минутах (по умолчанию 7 дней). Отзыва
# токенов нет: выключенная учётка (is_active=false) отбивается на каждом запросе.
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Демо-режим публичного стенда: вход только гостем, у каждого своя песочница с копией
# демо-проекта (docs/tasks/demo-mode.md). Второй экземпляр рядом с основным — scripts/dev-demo.sh.
# DEMO_MODE=false
# Сколько живых песочниц стенд держит разом и сколько новых в час пускает с одного адреса.
# DEMO_MAX_SANDBOXES=300
# DEMO_START_PER_IP_PER_HOUR=10

# Режим одного процесса (app/standalone.py — образ OpenShift без nginx, DEPLOY.md):
# каталог сборки фронта, предел размера запроса в МБ и неудачных попыток входа в
# минуту с одного адреса (0 — без ограничения). В dev (./dev.sh) не нужны.
# FRONTEND_DIR=
# MAX_REQUEST_MB=64
# LOGIN_ATTEMPTS_PER_MINUTE=10

# Адрес клиента для лимитов (вход, старт демо) — последний в X-Forwarded-For: его
# дописывает прокси перед ArchMap. Если прокси нет (docker compose), ставьте false —
# иначе клиент подделывает заголовок и обходит лимиты.
# TRUST_FORWARDED_FOR=true
