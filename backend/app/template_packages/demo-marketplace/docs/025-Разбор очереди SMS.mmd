%% archmap-name: Разбор очереди SMS
%% archmap-kind: worker
%% archmap-node: Маркетплейс «Ярмарка» / Сервис уведомлений / SMS-рассыльщик
graph TD
  A["Проснуться по интервалу<br>зависит от: SMS_POLL_INTERVAL"] --> B["Взять пачку уведомлений без отправленной SMS<br>читает: notifications<br>зависит от: SMS_BATCH_SIZE"]
  B --> C{"Пачка пуста?"}
  C -->|Да| D["Спать до следующего цикла"]
  C -->|Нет| E{"Прогон без отправки?<br>зависит от: SMS_DRY_RUN"}
  E -->|Да| F["Отметить пропуск в журнале<br>пишет: notifications.status"]
  E -->|Нет| G["Отправить SMS через провайдера<br>зависит от: PROVIDER_API_KEY"]
  G --> H{"Провайдер принял?"}
  H -->|Да| I["Отметить отправленной<br>пишет: notifications.status"]
  H -->|Нет| J["Пометить отправку проваленной<br>пишет: notifications.status"]
  J --> K["Лог ERROR: SMS не ушла — номер получателя и код ответа провайдера"]
  F --> D
  I --> D
  K --> D
