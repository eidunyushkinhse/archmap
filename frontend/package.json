{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:embed": "tsc -b && vite build --config vite.embed.config.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "gen:api": "(cd ../backend && venv/bin/python -c \"from app.main import app; import json,sys; json.dump(app.openapi(), sys.stdout)\") | openapi-typescript /dev/stdin -o src/types/api.gen.ts",
    "replay-prof": "tsx scripts/replay-prof.ts",
    "route-quality": "tsx scripts/route-quality.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "@xyflow/system": "0.0.83",
    "elkjs": "^0.11.1",
    "js-yaml": "^5.4.3",
    "mermaid": "^12.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "swagger-ui-dist": "^5.33.2"
  },
  "comment:overrides": "openapi-typescript ещё держит peer typescript ^5.x; проект на TS 6 (bleeding-edge). Сужаем peer этого dev-тула до нашей версии — узко, без глобального legacy-peer-deps. Генерат работает с TS 6 (проверено tsc -b).",
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "mermaid": {
      "elkjs": "$elkjs"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui-dist": "^3.30.6",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
